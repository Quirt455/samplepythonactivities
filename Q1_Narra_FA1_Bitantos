        "\n",
        "import math\n",
        "\n",
        "# Get the coordinates of the two points from the user.\n",
        "x1 = float(input(\"Enter x1: \"))\n",
        "y1 = float(input(\"Enter y1: \"))\n",
        "x2 = float(input(\"Enter x2: \"))\n",
        "y2 = float(input(\"Enter y2: \"))\n",
        "\n",
        "# Find the difference between the x and y coordinates.\n",
        "diff_x = x1 - x2\n",
        "diff_y = y1 - y2\n",
        "\n",
        "# Square the differences.\n",
        "squared_diff_x = math.pow(diff_x, 2)\n",
        "squared_diff_y = math.pow(diff_y, 2)\n",
        "\n",
        "# Add the squared differences.\n",
        "sum_of_square_diffs = squared_diff_x + squared_diff_y\n",
        "\n",
        "# Calculate and round the distance to two decimal places.\n",
        "distance = round(math.sqrt(sum_of_square_diffs), 2)\n",
        "\n",
        "print(\"distance\")\n",
        "\n",
        "# The math library provides pre-built and tested functions such as\n",
        "# math.sqrt() and math.pow(). Using these functions saves time,\n",
